{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "bun.lock",
    "playwright-report/**",
    "test-results/**"
  ]
}
