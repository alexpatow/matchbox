{
  "name": "matchbox-ai",
  "version": "0.4.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpatow/matchbox.git",
    "directory": "packages/cli"
  },
  "bin": {
    "matchbox-ai": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "templates",
    "docs",
    "skills",
    "workbench",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/package-docs.ts cli && bun ../../scripts/package-templates.ts && rolldown --config && chmod +x dist/cli.js && tsc -p tsconfig.build.json",
    "dev": "bun run --parallel \"dev:*\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json && tsc -p workbench/tsconfig.json",
    "dev:js": "rolldown --config --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@inkjs/ui": "^2.0.0",
    "@matchbox-ai/core": "0.4.1",
    "@matchbox-ai/train": "0.4.1",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "open": "^11.0.3",
    "package-manager-detector": "^1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "rolldown": "1.2.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  }
}
