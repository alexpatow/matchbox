{
  "name": "@matchbox-ai/core",
  "version": "0.0.0",
  "private": true,
  "description": "Compile examples into tiny models for the browser.",
  "bin": {
    "matchbox": "./dist/train/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./train": {
      "types": "./dist/train/index.d.ts",
      "import": "./dist/train/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "rolldown --config && tsc -p tsconfig.build.json",
    "dev": "bun run --parallel \"dev:*\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "dev:js": "rolldown --config --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "rolldown": "1.2.8",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
