{
  "name": "@matchbox-ai/core",
  "version": "0.2.2",
  "description": "Compile examples into tiny models for the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpatow/matchbox.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#wasm": {
      "types": "./dist/runtime/burn/load-browser.d.ts",
      "node": "./dist/load-node.js",
      "default": "./dist/load-browser.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "import": "./dist/internal/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/package-docs.ts core && rolldown --config && tsc -p tsconfig.build.json && bun ../../scripts/copy-rust.ts core",
    "dev": "bun run --parallel \"dev:*\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "dev:js": "rolldown --config --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "rolldown": "1.2.8",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
