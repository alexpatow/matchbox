{
  "name": "@matchbox-ai/train",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "matchbox": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rolldown --config && tsc -p tsconfig.build.json",
    "dev": "bun run --parallel \"dev:*\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "dev:js": "rolldown --config --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@matchbox-ai/core": "workspace:*",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "rolldown": "1.2.8",
    "typescript": "7.0.2"
  }
}
