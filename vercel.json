{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bunx bun@1.4.2 install --frozen-lockfile",
  "buildCommand": "bunx bun@1.4.2 run train && bunx bun@1.4.2 run --filter @matchbox-ai/playground build",
  "outputDirectory": "apps/playground/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
